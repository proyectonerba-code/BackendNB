# Grupo NERBA HIDALGO - ejemplo de variables de entorno
# Copia a .env en local. En Railway define estas en el panel Variables.
PORT=8080
FRONT_DIR=../NERBA Front
FRONTEND_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=
# --- NerBot (chatbot con Gemini) ---
# La clave SOLO vive en el servidor. Sin ella el chat responde con el fallback.
GEMINI_API_KEY=
# Modelo. Si da 503 "high demand" (Google saturado), prueba con el de abajo.
# Si da 404, el modelo fue retirado para tu llave: el bot cae solo a otro.
GEMINI_MODEL=gemini-2.5-flash
# off = no mandar thinkingConfig | budget = thinkingBudget (2.5)
# | low|medium|high = thinkingLevel (familia 3.x). Si el modelo lo rechaza,
# el chat cae al fallback: en ese caso pon off.
GEMINI_THINKING_LEVEL=budget
# 1 = el equipo interno (ADMIN/SUPERADMIN...) tambien puede usar NerBot, para
# probarlo antes de publicarlo. 0 = solo CLIENTE.
NERBOT_STAFF=1
# Cache de respuestas: muchos clientes preguntan lo mismo y no tiene por que
# gastarse cuota cada vez. Minutos que vive una respuesta cacheada y cuantos
# lugares se guardan como maximo.
NERBOT_CACHE_MIN=180
NERBOT_CACHE_MAX=500
WHATSAPP_GENERAL=527751300335
WHATSAPP_SEGURIDAD=527751300335
WHATSAPP_PORTONES=527751300335
WHATSAPP_MANTENIMIENTO=527751300335
WHATSAPP_VENTA_PARTES=527751300335
WHATSAPP_TECNOLOGIA_VARIADA=527717838508
WHATSAPP_PROYECTOS_ESPECIALES=527751300335
WHATSAPP_PRODUCTOS_ELECTRONICOS=527717838508
SEED_DEMO=1
SERVE_STATIC=1
# Recuperacion de contrasena por correo. Orden de intento:
# Brevo (HTTPS) -> Resend (HTTPS) -> SMTP (465/587). Railway bloquea los puertos
# SMTP, por eso ahi se usa Brevo o Resend. Sin ninguna key, /api/recuperar
# responde 503 y el sitio avisa que escriba a gruponerba@hotmail.com.
BREVO_API_KEY=
BREVO_FROM=proyectonerba@gmail.com
BREVO_FROM_NAME=Grupo NERBA HIDALGO
RESEND_API_KEY=
RESEND_FROM=Nerba <onboarding@resend.dev>
# Gmail/otro SMTP (solo donde haya salida SMTP: VPS, Hostinger).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=Grupo NERBA HIDALGO <tucorreo@gmail.com>
# PDF: el servidor genera el documento oficial con pdfkit (una sola plantilla
# para todas las areas). Sin la dependencia, /pdf responde 501 y el front usa
# la vista de impresion.
# Minutos de validez del enlace de un solo uso.
RESET_MINUTOS=30
# En producción Railway (API sola): SEED_DEMO=0, SERVE_STATIC=0
# FRONTEND_URL acepta varios origenes separados por coma (CORS), util durante
# una migracion de hosting. Ej: https://sitio-a.com,https://sitio-b.pages.dev
# En produccion define siempre la lista; vacio deja '*' (solo desarrollo).
# Recuperacion de contrasena por correo.
# Hay DOS proveedores posibles y el servidor usa el que este configurado.
#
# A) Resend (recomendado). Dominio propio verificado en resend.com.
#    La API key empieza con "re_". Sin dominio verificado, Resend solo envia
#    al correo de la propia cuenta.
#    OJO: no se puede enviar DESDE un gmail/hotmail. El remitente tiene que
#    ser del dominio verificado (RESEND_FROM).
RESEND_API_KEY=
RESEND_FROM=Nerba <onboarding@resend.dev>
#
# B) Gmail por SMTP. Se usa si NO hay RESEND_API_KEY, o si Resend falla.
#    SMTP_PASS debe ser una CONTRASENA DE APLICACION de 16 digitos, no la
#    contrasena normal de la cuenta: Google -> Cuenta -> Seguridad ->
#    Verificacion en dos pasos -> Contrasenas de aplicacion.
#    SMTP_FROM debe llevar la MISMA direccion que SMTP_USER, o Gmail lo
#    rebota con "The sender address does not match any of the
#    authenticated identities".
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Grupo NERBA HIDALGO <tu-correo@gmail.com>
# 465 es SMTPS. Si el host de despliegue lo bloquea, usa 587 con STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
#
# Minutos de validez del enlace de un solo uso.
RESET_MINUTOS=30
# Devuelve el enlace de recuperacion en la respuesta. SOLO para pruebas:
# con esto, cualquiera puede cambiar la contrasena de quien sepa su correo.
RECOVERY_DEBUG=
# En producción Railway (API sola): SEED_DEMO=0, SERVE_STATIC=0, FRONTEND_URL=https://tu-sitio.netlify.app
# En producción Railway: SEED_DEMO=0, FRONTEND_URL=https://tu-dominio.up.railway.app
# Futura DB (migración pendiente):
# DATABASE_URL=postgresql://user:pass@host:5432/nerba
# PGSSL=0 solo si tu Postgres no usa SSL (Railway sí usa: deja por defecto)
# RECOVERY_DEBUG=1 devuelve el enlace de recuperación en la respuesta (solo pruebas)
