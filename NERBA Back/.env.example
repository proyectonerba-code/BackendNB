# Grupo NERBA HIDALGO - ejemplo de variables de entorno
# Copia a .env en local. En Railway define estas en el panel Variables.
PORT=8080
FRONT_DIR=../NERBA Front
FRONTEND_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=
SEED_DEMO=1
SERVE_STATIC=1
# En producción Railway (API sola): SEED_DEMO=0, SERVE_STATIC=0, FRONTEND_URL=https://tu-sitio.netlify.app
# En producción Railway: SEED_DEMO=0, FRONTEND_URL=https://tu-dominio.up.railway.app
# Futura DB (migración pendiente):
# DATABASE_URL=postgresql://user:pass@host:5432/nerba
